# Copy to .env and fill in. `docker compose up -d` reads it automatically.

# --- Honeycomb ------------------------------------------------------------------------------------------------
# An INGEST key for the environment you want the playground data in (a dedicated environment is best).
HONEYCOMB_API_KEY=
# EU teams: https://api.eu1.honeycomb.io
HONEYCOMB_API_ENDPOINT=https://api.honeycomb.io
# Optional: a Configuration key with "Manage Markers" - scenario/deploy markers in Honeycomb.
HONEYCOMB_CONFIG_KEY=

# --- Collector pipelines ----------------------------------------------------------------------------------------
# Honeycomb keeps all metrics in one place, so each path is told apart by the resource attribute
# `collection.method`. Change a value to label an experiment (see labs/05-three-paths.md), e.g.
# COLLECTION_METHOD_FEDERATE=prometheus-federate-repaired, and compare it with the earlier data.
COLLECTION_METHOD_SCRAPE=prometheus-scrape
COLLECTION_METHOD_FEDERATE=prometheus-federate
COLLECTION_METHOD_OTLP=otlp-push

# Each is a YAML list of exporters. Use [nop] to switch a path off (saves Honeycomb volume), or add debug to print
# what the collector converted, e.g. [otlp_http/honeycomb, debug] and COLLECTOR_DEBUG_VERBOSITY=detailed.
PIPELINE_SCRAPE_EXPORTERS=[otlp_http/honeycomb]
PIPELINE_FEDERATE_EXPORTERS=[otlp_http/honeycomb]
PIPELINE_OTLP_EXPORTERS=[otlp_http/honeycomb]
PIPELINE_HOSTMETRICS_EXPORTERS=[otlp_http/honeycomb]
COLLECTOR_DEBUG_VERBOSITY=basic
# Lab 05: add transform/federate_repair to turn federated `_total` gauges back into counters.
# If the federate path's counter-vs-gauge name clash causes trouble in Honeycomb, add transform/federate_prefix too.
PIPELINE_FEDERATE_PROCESSORS=[memory_limiter, resource/federate, batch]
# PIPELINE_FEDERATE_PROCESSORS=[memory_limiter, transform/federate_repair, resource/federate, batch]
# PIPELINE_FEDERATE_PROCESSORS=[memory_limiter, transform/federate_prefix, resource/federate, batch]

# --- Simulator --------------------------------------------------------------------------------------------------
SIM_BASE_RPS=30            # front-door requests/s at the daily peak
SIM_DAY_LENGTH=60m         # one full diurnal traffic cycle
SIM_OTLP_ENABLED=true
SIM_OTLP_INTERVAL=15s
# OTLP push knobs (these are standard OTel SDK env vars, passed through):
OTLP_TEMPORALITY=delta                              # delta | cumulative | lowmemory
OTLP_HISTOGRAM=base2_exponential_bucket_histogram   # or explicit_bucket_histogram

# --- cAdvisor -----------------------------------------------------------------------------------------------------
# Only needed if cAdvisor shows no per-container metrics (see docker compose logs cadvisor | grep factory).
# On a Linux VM with Docker Engine this is almost always the right value:
# CADVISOR_CONTAINERD_SOCK=/run/containerd/containerd.sock

# --- Where it runs (see VM.md) ----------------------------------------------------------------------------------
# Interface the published ports listen on. 127.0.0.1 = only this machine (laptop default). On a private VM: 0.0.0.0,
# then browse to http://<vm-dns-name>:8080. Nothing here has authentication, so keep it off the public internet.
PLAYGROUND_BIND=127.0.0.1
# Pull the simulator and docs images from a registry instead of building them locally (empty = build locally).
# PLAYGROUND_REGISTRY=harbor.jbcodes.net/library
# PLAYGROUND_TAG=0.1.0
